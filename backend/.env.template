APP_NAME=社团管理与活动报名系统                                     # 应用名称，显示在网页标题和系统中
DB_TYPE=auto                                                      # 数据库类型：auto（自动检测，有MySQL密码则用MySQL否则SQLite）| sqlite（无需安装，开箱即用）| mysql（需MySQL服务）
SQLITE_PATH=club_system.db                                        # SQLite数据库文件路径（使用SQLite时生效，默认保存在程序同级目录）
DB_HOST=localhost                                                 # MySQL服务器地址（DB_TYPE=mysql时需要填写）
DB_PORT=3306                                                      # MySQL服务器端口（DB_TYPE=mysql时需要填写，默认3306）
DB_USER=root                                                      # MySQL数据库用户名（DB_TYPE=mysql时需要填写）
DB_PASSWORD=                                                      # MySQL数据库密码（DB_TYPE=mysql时需要填写，留空则自动使用SQLite）
DB_NAME=club_system                                               # MySQL数据库名称（DB_TYPE=mysql时需要填写）
SECRET_KEY=请随机生成一段密钥字符串                                    # JWT令牌签名密钥，用于用户登录认证，请务必修改为随机字符串
DEEPSEEK_API_KEY=请填写你的DeepSeek API Key(sk-开头，不填则AI功能不可用)  # DeepSeek大模型API密钥，不填则AI助手、AI生成海报等功能不可用
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1                     # DeepSeek API接口地址，使用默认值即可，无需修改
ALGORITHM=HS256                                                   # JWT加密算法，使用默认HS256即可，无需修改
ACCESS_TOKEN_EXPIRE_MINUTES=1440                                  # 登录令牌有效期（分钟），默认1440即24小时后自动退出
DEBUG=true                                                        # 调试模式开关：true开启（开发/测试）| false关闭（正式使用）
UPLOAD_DIR=uploads                                                # 文件上传保存目录，用户上传的图片等资源存放在此目录
POSTER_DIR=static/posters                                         # 社团海报图片存放目录，AI生成的海报保存在此目录
